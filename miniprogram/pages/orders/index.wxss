.role-hint { background: #e6f5ec; color: #4c8a68; border-radius: 20rpx; padding: 20rpx 24rpx; margin-bottom: 26rpx; }.tip { margin-top: 12rpx; font-size: 24rpx; }
.order { padding: 26rpx; margin-bottom: 22rpx; }.order-head, .order-foot { display: flex; justify-content: space-between; align-items: center; }.order-icon { font-size: 38rpx; margin-right: 15rpx; }.order-title, .strong { font-weight: 700; }.status { color: #d86a58; background: #fff0e9; border-radius: 999rpx; padding: 8rpx 16rpx; font-size: 22rpx; }.status.done { color: #4e9870; background: #e3f4e9; }.status.serving { color: #397fa3; background: #e3f2fa; }
.pet-line { display: flex; align-items: center; margin: 28rpx 0 18rpx; }.pet-dot { width: 72rpx; height: 72rpx; border-radius: 50%; background: #fff3df; display: flex; align-items: center; justify-content: center; margin-right: 18rpx; }.muted { font-size: 23rpx; margin-top: 5rpx; }.address { font-size: 24rpx; color: #706760; padding-bottom: 24rpx; border-bottom: 1rpx solid #f1ebe6; }.order-foot { padding-top: 20rpx; }.amount { font-size: 34rpx; color: #e76958; font-weight: 800; }
