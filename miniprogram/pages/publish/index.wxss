.intro { display: flex; align-items: center; padding: 12rpx 4rpx 14rpx; }.intro-icon { width: 90rpx; height: 90rpx; display: flex; align-items: center; justify-content: center; border-radius: 28rpx; background: #ffe7dd; font-size: 48rpx; margin-right: 20rpx; }.intro-title { font-size: 34rpx; font-weight: 800; margin-bottom: 7rpx; }
.type-row { display: flex; justify-content: space-between; }.type { width: 29%; height: 128rpx; border-radius: 24rpx; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 42rpx; border: 3rpx solid transparent; }.type text { font-size: 24rpx; font-weight: 600; margin-top: 6rpx; }.type.active { border-color: #f47d6b; background: #fff7f3; }
.form-card { padding: 0 26rpx; }.pet { display: flex; align-items: center; padding: 24rpx 26rpx; }.pet-avatar { width: 82rpx; height: 82rpx; background: #e4f5ea; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 42rpx; margin-right: 20rpx; }.grow { flex: 1; }.strong { font-weight: 700; font-size: 31rpx; }.arrow { font-size: 48rpx; color: #b7ada6; }
.field, .task { min-height: 96rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #f1ebe6; }.field.last, .task.last { border-bottom: 0; }.value { color: #8a8078; max-width: 390rpx; }.address { font-size: 23rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.task { justify-content: flex-start; }.check { width: 38rpx; height: 38rpx; border: 2rpx solid #d9d0ca; border-radius: 50%; margin-right: 20rpx; color: #fff; text-align: center; line-height: 38rpx; }.check.checked { background: #58b387; border-color: #58b387; }
.notes { box-sizing: border-box; width: 100%; height: 180rpx; padding: 24rpx; }
.price-bar { display: flex; align-items: center; justify-content: space-between; margin-top: 36rpx; }.total { color: #ed6e5d; font-size: 45rpx; font-weight: 800; }.submit { width: 360rpx; margin: 0; }
