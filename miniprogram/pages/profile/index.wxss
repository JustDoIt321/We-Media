.profile { display: flex; align-items: center; padding: 32rpx; }.avatar { width: 104rpx; height: 104rpx; border-radius: 34rpx; background: linear-gradient(135deg,#ffd9ca,#ffedca); display: flex; align-items: center; justify-content: center; font-size: 54rpx; margin-right: 22rpx; }.grow { flex: 1; }.name { font-size: 36rpx; font-weight: 800; margin-bottom: 7rpx; }.cert { color: #4da778; font-size: 22rpx; }
.roles { display: flex; justify-content: space-between; }.role { width: 41%; padding: 26rpx; display: flex; align-items: center; border: 3rpx solid transparent; }.role.active { border-color: #f47d6b; background: #fff8f4; }.role-icon { font-size: 42rpx; margin-right: 13rpx; }.role-title { font-weight: 700; }.role .muted { font-size: 19rpx; margin-top: 6rpx; }
.stats { display: flex; justify-content: space-around; text-align: center; padding: 30rpx 10rpx; margin-top: 24rpx; }.stats view { flex: 1; border-right: 1rpx solid #eee7e1; }.stats view:last-child { border: 0; }.num { display: block; font-size: 38rpx; font-weight: 800; margin-bottom: 7rpx; }.stats .muted { display: block; font-size: 21rpx; }
.menu { margin-top: 26rpx; padding: 0 26rpx; }.menu-item { height: 96rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #f0eae5; }.menu-item.last { border: 0; }.safe { text-align: center; color: #9a918a; font-size: 21rpx; margin-top: 32rpx; }
