.status-card { padding: 30rpx; display: flex; align-items: center; background: linear-gradient(135deg,#fff,#fff0e7); }.status-icon { width: 90rpx; height: 90rpx; display: flex; align-items: center; justify-content: center; border-radius: 28rpx; background: #fff3db; font-size: 46rpx; margin-right: 22rpx; }.status-title { font-size: 36rpx; font-weight: 800; margin-bottom: 7rpx; }
.info { padding: 0 26rpx; }.info view { display: flex; justify-content: space-between; padding: 25rpx 0; border-bottom: 1rpx solid #f1ebe6; }.info view:last-child { border: 0; }.info-value { max-width: 420rpx; text-align: right; font-weight: 700; }.checklist { padding: 12rpx 26rpx; }.checklist view { padding: 18rpx 0; }.tick { display: inline-flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border-radius: 50%; background: #5bb386; color: #fff; margin-right: 18rpx; }
.report { padding: 28rpx; }.report-title { font-size: 31rpx; font-weight: 700; }.report-text { color: #716760; line-height: 1.8; margin: 16rpx 0 24rpx; }.photos { display: flex; justify-content: space-between; }.photos view { width: 30%; height: 130rpx; background: #fff0df; border-radius: 18rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 38rpx; }.photos text { font-size: 18rpx; color: #9a8d83; margin-top: 8rpx; }
.safety, .owner-note { text-align: center; color: #8b817a; font-size: 21rpx; margin: 30rpx 0; }.action { margin-top: 30rpx; }.owner-note { background: #fff; border-radius: 18rpx; padding: 22rpx; }
