.top { text-align: center; padding: 38rpx 28rpx 0; }.avatar { width: 132rpx; height: 132rpx; border-radius: 50%; background: #fff0df; display: flex; align-items: center; justify-content: center; font-size: 70rpx; margin: 0 auto; }.name { font-size: 40rpx; font-weight: 800; margin-top: 16rpx; }.badge { color: #d26b5b; margin-top: 7rpx; }.verified { display: inline-block; color: #4b9e71; background: #e7f6ed; border-radius: 999rpx; padding: 9rpx 18rpx; margin-top: 18rpx; font-size: 21rpx; }
.metrics { display: flex; margin-top: 32rpx; border-top: 1rpx solid #f1e9e3; padding: 25rpx 0; }.metrics view { flex: 1; border-right: 1rpx solid #f1e9e3; }.metrics view:last-child { border: 0; }.metrics text { display: block; }.metrics .metric-value { color: #332f2c; font-size: 32rpx; font-weight: 700; }.metrics text { color: #8a8078; font-size: 20rpx; margin-top: 4rpx; }
.content, .review { padding: 28rpx; line-height: 1.8; }.review-text { margin: 18rpx 0; }.review .muted { float: right; font-size: 21rpx; }
.bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 34rpx; }.price { font-size: 42rpx; font-weight: 800; color: #e66958; }.bottom button { width: 350rpx; margin: 0; }
