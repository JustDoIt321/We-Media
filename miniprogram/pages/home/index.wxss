.hero { min-height: 330rpx; padding: 40rpx; background: linear-gradient(135deg, #ffd8c9, #ffe9c6); position: relative; overflow: hidden; }
.hero-copy { position: relative; z-index: 2; }
.eyebrow { font-size: 21rpx; letter-spacing: 3rpx; color: #bf6658; font-weight: 700; }
.hero-title { font-size: 48rpx; line-height: 1.25; font-weight: 800; margin-top: 20rpx; }.hero-title text { display: block; }
.hero-desc { color: #7d6258; margin-top: 20rpx; }
.hero-pet { position: absolute; right: -5rpx; bottom: -42rpx; width: 250rpx; height: 250rpx; border-radius: 50%; background: #fff8ed; display: flex; align-items: center; justify-content: center; }
.face { font-size: 50rpx; color: #5c4941; }
.ear { position: absolute; top: -18rpx; width: 90rpx; height: 100rpx; background: #fff8ed; transform: rotate(45deg); border-radius: 22rpx; }
.ear.left { left: 30rpx; }.ear.right { right: 30rpx; }
.notice { background: #fff; border-radius: 18rpx; padding: 20rpx 26rpx; color: #795f55; margin-top: 22rpx; font-size: 25rpx; }
.service-grid { display: flex; justify-content: space-between; }
.service-card { width: 27%; padding: 26rpx 18rpx; border-radius: 24rpx; min-height: 180rpx; }
.service-card.peach { background: #ffe7de; }.service-card.mint { background: #dff5e8; }.service-card.blue { background: #e4efff; }
.service-icon { font-size: 48rpx; }.service-name { font-weight: 700; margin-top: 16rpx; }.service-desc { color: #7c746f; font-size: 21rpx; line-height: 1.5; margin-top: 8rpx; }
.title-row { display: flex; justify-content: space-between; align-items: center; }.title-row .muted { font-size: 23rpx; }
.provider { padding: 25rpx; display: flex; align-items: center; margin-bottom: 20rpx; }
.avatar { width: 92rpx; height: 92rpx; background: #fff2e5; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 48rpx; }
.provider-main { flex: 1; margin-left: 22rpx; }.provider-name { font-size: 31rpx; font-weight: 700; }.verified { font-size: 20rpx; color: #50a77a; margin-left: 12rpx; }.badge { color: #cf6b5b; font-size: 23rpx; margin-top: 6rpx; }.provider-meta { color: #8a8078; font-size: 22rpx; margin-top: 9rpx; }
.price { color: #e96858; font-size: 36rpx; font-weight: 800; }.price text { font-size: 22rpx; }.price .unit { font-size: 19rpx; font-weight: 400; }
